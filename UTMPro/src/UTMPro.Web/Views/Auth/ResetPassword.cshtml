@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Reset Password - UTMPro</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 w-full max-w-md mx-2">
        <h1 class="text-2xl font-bold text-center mb-6">Set New Password</h1>
        @if (ViewBag.Error != null) { <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">@ViewBag.Error</div> }
        <form method="post" action="/reset-password">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <div class="mb-4"><label class="block text-sm font-medium text-gray-700 mb-2">New Password</label><input type="password" name="password" required minlength="8" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black" placeholder="Min 8 characters"></div>
            <button type="submit" class="w-full bg-black text-white py-2.5 rounded-lg font-medium hover:bg-gray-800">Update Password</button>
        </form>
    </div>
</body>
</html>
