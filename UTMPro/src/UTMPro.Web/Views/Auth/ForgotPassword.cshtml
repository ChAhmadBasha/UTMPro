@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Forgot Password - UTMPro</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 w-full max-w-md mx-2">
        <h1 class="text-2xl font-bold text-center mb-2">Reset Password</h1>
        <p class="text-gray-500 text-center mb-6">Enter your email and we'll send a reset link</p>
        @if (ViewBag.Success != null) { <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">@ViewBag.Success</div> }
        <form method="post" action="/forgot-password">
            @Html.AntiForgeryToken()
            <div class="mb-4"><input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-black" placeholder="you@example.com"></div>
            <button type="submit" class="w-full bg-black text-white py-2.5 rounded-lg font-medium hover:bg-gray-800">Send Reset Link</button>
        </form>
        <p class="text-center text-sm text-gray-500 mt-6"><a href="/login" class="text-black font-medium hover:underline">Back to login</a></p>
    </div>
</body>
</html>
