@{ var logo = ViewBag.SiteLogo as string; var footer = ViewBag.FooterText as string; var email = ViewBag.ContactEmail as string; }
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@ViewData["Title"] — UTMPro</title>
<meta name="description" content="@ViewData["Description"]">
<script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-white min-h-screen flex flex-col">
<nav class="border-b"><div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href="/" class="flex items-center gap-2">@if(!string.IsNullOrEmpty(logo)){<img src="@logo" alt="UTMPro" class="h-8">}<span class="text-xl font-bold">UTMPro</span></a>
    <div class="flex gap-4 items-center text-sm">
        <a href="/about" class="text-gray-600 hover:text-black">About</a>
        <a href="/blog" class="text-gray-600 hover:text-black">Blog</a>
        <a href="/docs" class="text-gray-600 hover:text-black">Docs</a>
        <a href="/pricing" class="text-gray-600 hover:text-black">Pricing</a>
        <a href="/contact" class="text-gray-600 hover:text-black">Contact</a>
        <a href="/login" class="bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800">Login</a>
    </div>
</div></nav>

<main class="flex-1">
    @if(TempData["Success"]!=null){<div class="max-w-4xl mx-auto mt-4 px-6"><div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">@TempData["Success"]</div></div>}
    @if(TempData["Error"]!=null){<div class="max-w-4xl mx-auto mt-4 px-6"><div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">@TempData["Error"]</div></div>}
    @RenderBody()
</main>

<footer class="border-t py-10 mt-16">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-4 gap-8 mb-8">
            <div><span class="font-bold text-lg">UTMPro</span><p class="text-sm text-gray-500 mt-2">Modern link management platform.</p>@if(!string.IsNullOrEmpty(email)){<p class="text-sm text-gray-400 mt-2">📧 @email</p>}</div>
            <div><h4 class="font-semibold text-sm mb-3">Product</h4><div class="space-y-2 text-sm text-gray-500"><a href="/pricing" class="block hover:text-black">Pricing</a><a href="/docs" class="block hover:text-black">Documentation</a><a href="/docs/api" class="block hover:text-black">API Reference</a><a href="/blog" class="block hover:text-black">Blog</a></div></div>
            <div><h4 class="font-semibold text-sm mb-3">Company</h4><div class="space-y-2 text-sm text-gray-500"><a href="/about" class="block hover:text-black">About Us</a><a href="/contact" class="block hover:text-black">Contact Us</a><a href="/privacy" class="block hover:text-black">Privacy Policy</a><a href="/terms" class="block hover:text-black">Terms of Service</a></div></div>
            <div><h4 class="font-semibold text-sm mb-3">Features</h4><div class="space-y-2 text-sm text-gray-500"><p>Link Shortening</p><p>Analytics & Attribution</p><p>QR Codes</p><p>Partner Program</p><p>Custom Domains</p></div></div>
        </div>
        <div class="border-t pt-6 text-center text-gray-400 text-sm">@(footer ?? "© 2026 UTMPro. All rights reserved.")</div>
    </div>
</footer>
</body></html>
