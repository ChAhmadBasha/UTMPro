@model List<APIKey>
@{ ViewData["Title"] = "API Keys"; var ws = ViewBag.Workspace as Workspace; }
<h1 class="text-2xl font-bold mb-6">API Keys</h1>
@if (TempData["Success"] != null) { <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm font-mono">@TempData["Success"]</div> }
<div class="bg-white rounded-xl border p-6 mb-6 max-w-2xl">
    <h2 class="font-semibold mb-4">Create New API Key</h2>
    <form method="post" action="/@ws?.Slug/settings/tokens" class="flex gap-3">@Html.AntiForgeryToken()
        <input type="text" name="name" required placeholder="Key name" class="flex-1 px-3 py-2 border rounded-lg text-sm">
        <button type="submit" class="bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800">Generate Key</button>
    </form>
</div>
<div class="bg-white rounded-xl border overflow-hidden">
    @if (Model.Count == 0) { <div class="text-center py-12"><p class="text-gray-500">No API keys</p></div> }
    else { <div class="table-wrap"><table class="w-full min-w-[600px]"><thead class="bg-gray-50 border-b"><tr>
        <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Name</th>
        <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Key Prefix</th>
        <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Last Used</th>
        <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Status</th>
        <th class="px-4 py-3"></th>
    </tr></thead><tbody class="divide-y divide-gray-100">
    @foreach (var k in Model) { <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 text-sm font-medium">@k.Name</td>
        <td class="px-4 py-3 text-sm font-mono text-gray-500">@k.KeyPrefix...</td>
        <td class="px-4 py-3 text-sm text-gray-500">@(k.LastUsedAt?.ToString("MMM d, HH:mm") ?? "Never")</td>
        <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs @(k.IsActive ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">@(k.IsActive ? "Active" : "Revoked")</span></td>
        <td class="px-4 py-3">@if (k.IsActive) { <form method="post" action="/@ws?.Slug/settings/tokens/@k.Id/delete" class="inline">@Html.AntiForgeryToken()<button type="submit" class="text-xs text-red-500 hover:underline" onclick="return confirm('Revoke this key?')">Revoke</button></form> }</td>
    </tr> } </tbody></table></div> }
</div>
