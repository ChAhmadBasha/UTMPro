@model List<WorkspaceMember>
@{ ViewData["Title"] = "Members"; var ws = ViewBag.Workspace as Workspace; }
<h1 class="text-2xl font-bold mb-6">Members</h1>
<div class="bg-white rounded-xl border overflow-hidden">
    <div class="table-wrap"><table class="w-full min-w-[600px]">
        <thead class="bg-gray-50 border-b"><tr>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Member</th>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Role</th>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Joined</th>
        </tr></thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var m in Model)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3"><p class="text-sm font-medium">@m.UserName</p><p class="text-xs text-gray-500">@m.UserEmail</p></td>
                    <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs font-medium @(m.Role == "Owner" ? "bg-black text-white" : "bg-gray-100 text-gray-700")">@m.Role</span></td>
                    <td class="px-4 py-3 text-sm text-gray-500">@m.InvitedAt.ToString("MMM d, yyyy")</td>
                </tr>
            }
        </tbody>
    </table></div>
</div>
