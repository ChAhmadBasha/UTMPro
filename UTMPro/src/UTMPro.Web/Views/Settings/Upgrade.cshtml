@model List<Plan>
@{ ViewData["Title"] = "Choose Plan"; var ws = ViewBag.Workspace as Workspace; var currentPlan = ViewBag.CurrentPlan as Plan; }
<div class="max-w-5xl mx-auto">
    <h1 class="text-2xl font-bold text-center mb-2">Choose Your Plan</h1>
    <p class="text-gray-500 text-center mb-8">Upgrade to unlock more features</p>

    @if (Model.Any(p => p.HasDiscount)) {
    <div class="bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-xl p-4 mb-8 text-center">
        <p class="text-sm font-medium text-green-700">
            🎉 <strong>Sale Active:</strong> Special discounts available on select plans!
        </p>
    </div>
    }

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-@(Math.Min(4, Model.Count(x => x.IsActive))) gap-6">
    @foreach(var p in Model.Where(x => x.IsActive)){
    <div class="relative bg-white rounded-2xl border p-6 @(p.Id == ws?.PlanId ? "ring-2 ring-black" : "") @(p.IsDefault && p.Id != ws?.PlanId ? "border-green-400" : "")">
        <!-- Discount Badge -->
        @if (p.HasDiscount && !string.IsNullOrEmpty(p.DiscountBadge)) {
        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="bg-gradient-to-r from-green-500 to-emerald-600 text-white px-3 py-1 rounded-full text-[10px] font-bold shadow-md whitespace-nowrap">
                @p.DiscountBadge
            </span>
        </div>
        }

        <h3 class="font-bold text-lg mt-1">@p.Name</h3>

        <!-- Price with discount -->
        @if (p.HasDiscount) {
            <div class="mt-2">
                <span class="text-xl text-gray-300 line-through">$@p.Price</span>
                <span class="text-3xl font-bold text-green-600 ml-1">$@p.DiscountedPrice</span>
                <span class="text-sm text-gray-500">/mo</span>
            </div>
            @if (p.DiscountPercent == 100) {
                <span class="inline-block mt-1 px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs font-bold">FREE</span>
            } else {
                <span class="inline-block mt-1 px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs font-bold">@p.DiscountPercent% OFF</span>
            }
            @if (p.TrialDays > 0) {
                <p class="text-xs text-gray-400 mt-1">Free for @(p.TrialDays / 30) months, then $@p.Price/mo</p>
            }
        } else {
            <p class="text-3xl font-bold mt-2">$@p.Price<span class="text-sm text-gray-500 font-normal">/mo</span></p>
        }

        <ul class="mt-4 space-y-2 text-sm text-gray-600">
            <li>✓ @p.MaxLinksPerMonth.ToString("N0") links/mo</li>
            <li>✓ @p.MaxEventsPerMonth.ToString("N0") events/mo</li>
            <li>✓ @p.MaxDomains domains</li>
            <li>✓ @p.MaxMembers members</li>
            <li>✓ @p.AnalyticsRetentionDays-day analytics</li>
            @if(p.HasPasswordProtection){<li>✓ Password protection</li>}
            @if(p.HasABTesting){<li>✓ A/B Testing</li>}
            @if(p.HasAPIAccess){<li>✓ API Access</li>}
        </ul>

        @if(p.Id == ws?.PlanId){
            <div class="mt-6 text-center py-2 bg-gray-100 rounded-lg text-sm text-gray-500">Current Plan</div>
            @if (ws?.PlanEndDate.HasValue == true) {
                <p class="text-center text-xs text-orange-500 mt-1">Trial ends @ws.PlanEndDate.Value.ToString("MMM d, yyyy")</p>
            }
        }
        else if(p.Price > 0 && !p.HasDiscount){
        <form method="post" action="/@ws?.Slug/settings/billing/checkout" class="mt-6">@Html.AntiForgeryToken()
            <input type="hidden" name="planId" value="@p.Id">
            <input type="hidden" name="billingCycle" value="Monthly">
            <button type="submit" class="w-full py-2 bg-black text-white rounded-lg text-sm font-medium hover:bg-gray-800">Upgrade</button>
        </form>}
        else if(p.HasDiscount && p.DiscountedPrice == 0){
            <div class="mt-6 text-center py-2 bg-green-50 border border-green-200 rounded-lg text-sm text-green-700 font-medium">
                🎉 Free Trial — Sign up to activate
            </div>
        }
        else if(p.Price == 0 && !p.HasDiscount){
            <div class="mt-6 text-center py-2 bg-gray-50 rounded-lg text-sm text-gray-400">Free</div>
        }
        else {
        <form method="post" action="/@ws?.Slug/settings/billing/checkout" class="mt-6">@Html.AntiForgeryToken()
            <input type="hidden" name="planId" value="@p.Id">
            <input type="hidden" name="billingCycle" value="Monthly">
            <button type="submit" class="w-full py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700">Get @p.DiscountPercent% Off</button>
        </form>}
    </div>}
    </div>
</div>
