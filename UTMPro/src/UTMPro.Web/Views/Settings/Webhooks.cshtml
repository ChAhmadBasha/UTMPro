@model List<Webhook>
@{ ViewData["Title"] = "Webhooks"; }
<h1 class="text-2xl font-bold mb-6">Webhooks</h1>
<div class="bg-white rounded-xl border overflow-hidden">
    @if (Model.Count == 0) { <div class="text-center py-12"><p class="text-gray-500">No webhooks configured</p></div> }
    else {
    <div class="table-wrap"><table class="w-full min-w-[600px]">
        <thead class="bg-gray-50 border-b"><tr>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">URL</th>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Events</th>
            <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Status</th>
        </tr></thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var w in Model) {
            <tr><td class="px-4 py-3 text-sm font-medium">@w.Name</td><td class="px-4 py-3 text-sm text-gray-500 truncate max-w-xs">@w.Url</td><td class="px-4 py-3 text-xs text-gray-500">@w.Events</td><td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs @(w.IsActive ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-500")">@(w.IsActive ? "Active" : "Disabled")</span></td></tr>
            }
        </tbody>
    </table></div>
    }
</div>
