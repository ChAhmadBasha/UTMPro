@model List<PartnerBounty>
@{ ViewData["Title"] = "Bounties"; var ws = ViewBag.Workspace as Workspace; }
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Bounties</h1>
    <button onclick="document.getElementById('bountyModal').classList.remove('hidden')" class="bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800">+ Create Bounty</button>
</div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
@foreach (var b in Model) {
<div class="bg-white rounded-xl border p-5">
    <div class="flex justify-between items-start mb-2"><h3 class="font-semibold">@b.Title</h3><span class="text-lg font-bold text-green-600">$@b.BountyAmount</span></div>
    <p class="text-xs text-gray-500 mb-2">Type: @b.BountyType · Claims: @b.TotalClaims@(b.MaxClaims.HasValue ? $"/{b.MaxClaims}" : "")</p>
    <span class="px-2 py-1 rounded text-xs @(b.IsActive ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-500")">@(b.IsActive ? "Active" : "Closed")</span>
</div>}
</div>
<div id="bountyModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center">
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 sm:p-6 w-full max-w-md mx-2 sm:m-4">
        <div class="flex justify-between items-center mb-4"><h2 class="text-lg font-bold">Create Bounty</h2><button onclick="document.getElementById('bountyModal').classList.add('hidden')" class="text-gray-400 text-2xl">&times;</button></div>
        <form method="post" action="/@ws?.Slug/program/bounties">@Html.AntiForgeryToken()
            <div class="mb-4"><label class="block text-sm font-medium mb-2">Title</label><input type="text" name="title" required class="w-full px-3 py-2 border rounded-lg"></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mb-4">
                <div><label class="block text-sm font-medium mb-2">Amount ($)</label><input type="number" name="amount" step="0.01" required class="w-full px-3 py-2 border rounded-lg"></div>
                <div><label class="block text-sm font-medium mb-2">Type</label><select name="bountyType" class="w-full px-3 py-2 border rounded-lg"><option>Signup</option><option>Sale</option><option>Lead</option><option>Custom</option></select></div>
            </div>
            <button type="submit" class="w-full bg-black text-white py-2 rounded-lg font-medium hover:bg-gray-800">Create Bounty</button>
        </form>
    </div>
</div>
