@model List<Partner>
@{ ViewData["Title"] = "Partners"; var ws = ViewBag.Workspace as Workspace; var program = ViewBag.Program as PartnerProgram; }
<div class="flex items-center justify-between mb-6">
    <div><h1 class="text-2xl font-bold">Partners</h1><p class="text-gray-500 text-sm">@ViewBag.TotalCount total</p></div>
    <div class="flex gap-2">
        @foreach (var s in new[] { ("", "All"), ("Pending", "Pending"), ("Approved", "Approved"), ("Rejected", "Rejected") }) {
        <a href="/@ws?.Slug/program/partners?status=@s.Item1" class="px-3 py-1.5 text-sm rounded-lg @(ViewBag.Status as string == s.Item1 ? "bg-black text-white" : "bg-white border hover:bg-gray-50")">@s.Item2</a> }
    </div>
</div>
<div class="bg-white rounded-xl border overflow-hidden">
<div class="table-wrap"><table class="w-full min-w-[600px]"><thead class="bg-gray-50 border-b"><tr>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Partner</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Clicks</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Sales</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Revenue</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Commission</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Status</th>
</tr></thead><tbody class="divide-y divide-gray-100">
@foreach (var p in Model) {
<tr class="hover:bg-gray-50">
    <td class="px-4 py-3"><a href="/@ws?.Slug/program/partners/@p.Id" class="text-sm font-medium text-blue-600 hover:underline">@p.Name</a><p class="text-xs text-gray-500">@p.Email</p></td>
    <td class="px-4 py-3 text-sm text-right">@p.TotalClicks.ToString("N0")</td>
    <td class="px-4 py-3 text-sm text-right">@p.TotalSales</td>
    <td class="px-4 py-3 text-sm text-right font-medium">$@p.TotalRevenue.ToString("N2")</td>
    <td class="px-4 py-3 text-sm text-right">$@p.TotalCommission.ToString("N2")</td>
    <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs @(p.ApplicationStatus switch { "Approved" => "bg-green-100 text-green-700", "Pending" => "bg-yellow-100 text-yellow-700", "Rejected" => "bg-red-100 text-red-700", _ => "bg-gray-100 text-gray-700" })">@p.ApplicationStatus</span>@if(p.IsFlagged){<span class="ml-1 text-xs">🚩</span>}</td>
</tr>}
</tbody></table></div></div>
