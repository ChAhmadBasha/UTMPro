@model Partner
@{ ViewData["Title"] = Model.Name; var ws = ViewBag.Workspace as Workspace; var sales = ViewBag.Sales as List<PartnerSale>; var payouts = ViewBag.Payouts as List<PartnerPayout>; }
<div class="flex flex-wrap items-center gap-3 mb-6"><a href="/@ws?.Slug/program/partners" class="text-gray-400">&larr;</a><h1 class="text-2xl font-bold">@Model.Name</h1>
    <span class="px-2 py-1 rounded text-xs @(Model.ApplicationStatus == "Approved" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700")">@Model.ApplicationStatus</span>
    @if(Model.IsFlagged){<span class="px-2 py-1 rounded text-xs bg-red-100 text-red-700">🚩 Flagged (Score: @Model.FraudScore)</span>}
</div>
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4 mb-6">
    <div class="bg-white p-4 rounded-xl border"><p class="text-xs text-gray-500">Clicks</p><p class="text-xl font-bold">@Model.TotalClicks.ToString("N0")</p></div>
    <div class="bg-white p-4 rounded-xl border"><p class="text-xs text-gray-500">Sales</p><p class="text-xl font-bold">@Model.TotalSales</p></div>
    <div class="bg-white p-4 rounded-xl border"><p class="text-xs text-gray-500">Revenue</p><p class="text-xl font-bold">$@Model.TotalRevenue.ToString("N2")</p></div>
    <div class="bg-white p-4 rounded-xl border"><p class="text-xs text-gray-500">Commission</p><p class="text-xl font-bold">$@Model.TotalCommission.ToString("N2")</p></div>
    <div class="bg-white p-4 rounded-xl border"><p class="text-xs text-gray-500">Pending</p><p class="text-xl font-bold">$@Model.PendingBalance.ToString("N2")</p></div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
    <div class="bg-white rounded-xl border p-6"><h2 class="font-semibold mb-4">Details</h2><div class="space-y-2 text-sm">
        <div><span class="text-gray-500">Email:</span> @Model.Email</div>
        <div><span class="text-gray-500">Referral Code:</span> <code class="bg-gray-100 px-1 rounded">@Model.ReferralCode</code></div>
        <div><span class="text-gray-500">Referral URL:</span> <span class="text-xs break-all">@Model.ReferralUrl</span></div>
        <div><span class="text-gray-500">Country:</span> @(Model.Country ?? "Unknown")</div>
        <div><span class="text-gray-500">Joined:</span> @Model.CreatedAt.ToString("MMM d, yyyy")</div>
    </div></div>
    <div class="bg-white rounded-xl border p-6"><h2 class="font-semibold mb-4">Actions</h2><div class="space-y-2">
        @if(Model.ApplicationStatus == "Pending"){ <form method="post" action="/@ws?.Slug/program/partners/@Model.Id/approve">@Html.AntiForgeryToken()<button type="submit" class="w-full py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700">Approve</button></form>
        <form method="post" action="/@ws?.Slug/program/partners/@Model.Id/reject">@Html.AntiForgeryToken()<input type="text" name="reason" placeholder="Reason" class="w-full px-3 py-2 border rounded-lg text-sm mb-2"><button type="submit" class="w-full py-2 bg-red-600 text-white rounded-lg text-sm font-medium hover:bg-red-700">Reject</button></form>}
        @if(Model.ApplicationStatus == "Approved"){ <form method="post" action="/@ws?.Slug/program/partners/@Model.Id/suspend">@Html.AntiForgeryToken()<button type="submit" class="w-full py-2 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm" onclick="return confirm('Suspend partner?')">Suspend Partner</button></form>}
    </div></div>
</div>
@if(sales?.Count > 0){ <div class="bg-white rounded-xl border p-6 mt-6"><h2 class="font-semibold mb-4">Recent Sales</h2><table class="w-full text-sm"><thead class="bg-gray-50"><tr><th class="text-left px-3 py-2">Date</th><th class="text-right px-3 py-2">Amount</th><th class="text-right px-3 py-2">Commission</th><th class="text-left px-3 py-2">Status</th></tr></thead><tbody class="divide-y">
@foreach(var s in sales){<tr><td class="px-3 py-2 text-gray-500">@s.SaleDate.ToString("MMM d")</td><td class="px-3 py-2 text-right">$@s.SaleAmount.ToString("N2")</td><td class="px-3 py-2 text-right">$@s.CommissionAmount.ToString("N2")</td><td class="px-3 py-2"><span class="px-2 py-0.5 rounded text-xs @(s.Status == "Paid" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700")">@s.Status</span></td></tr>}
</tbody></table></div>}
