@{ ViewData["Title"] = "Bulk Import"; var ws = ViewBag.Workspace as Workspace; var domains = ViewBag.Domains as List<Domain>; }
<div class="max-w-2xl">
    <div class="flex items-center gap-3 mb-6"><a href="/@ws?.Slug/links" class="text-gray-400">&larr;</a><h1 class="text-2xl font-bold">Bulk Import Links</h1></div>
    <div class="bg-white rounded-xl border p-6">
        <p class="text-gray-500 text-sm mb-4">Upload a CSV file to import multiple links at once. Great for migrating from Bitly or other platforms.</p>
        <div class="bg-gray-50 p-4 rounded-lg mb-4">
            <p class="text-sm font-medium mb-2">CSV Format (first row = header):</p>
            <code class="text-xs text-gray-600 block bg-white p-3 rounded border font-mono">destination_url,custom_slug,utm_source,utm_medium,utm_campaign<br>https://example.com/page1,my-slug,google,cpc,summer2026<br>https://example.com/page2,,facebook,social,</code>
            <p class="text-xs text-gray-400 mt-2">Only <code>destination_url</code> is required. Other columns are optional.</p>
        </div>
        <form method="post" action="/@ws?.Slug/links/bulk/import" enctype="multipart/form-data">@Html.AntiForgeryToken()
            <div class="mb-4"><label class="block text-sm font-medium mb-2">Domain</label>
                <select name="domainId" class="w-full px-3 py-2 border rounded-lg">@if(domains!=null){foreach(var d in domains){<option value="@d.Id">@d.DomainName</option>}}</select>
            </div>
            <div class="mb-4"><label class="block text-sm font-medium mb-2">CSV File</label>
                <input type="file" name="csvFile" accept=".csv" required class="w-full px-3 py-2 border rounded-lg text-sm">
            </div>
            <button type="submit" class="w-full bg-black text-white py-2.5 rounded-lg font-medium hover:bg-gray-800">Import Links</button>
        </form>
    </div>
    <div class="mt-4"><a href="/@ws?.Slug/links/bulk/export" class="text-sm text-blue-600 hover:underline">📥 Export all links as CSV</a></div>
</div>
