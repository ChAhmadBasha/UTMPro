@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Create Link-in-Bio - UTMPro</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
<div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 w-full max-w-md mx-2">
    <div class="text-center mb-6"><div class="text-4xl mb-3">🔗</div><h1 class="text-2xl font-bold">Create Your Link-in-Bio</h1><p class="text-gray-500 mt-2">Share all your links on one page</p></div>
    @if(TempData["Error"]!=null){<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">@TempData["Error"]</div>}
    <form method="post" action="/account/bio/create">@Html.AntiForgeryToken()
        <div class="mb-4"><label class="block text-sm font-medium mb-2">Username</label>
            <div class="flex items-center border rounded-lg overflow-hidden"><span class="px-3 py-2 bg-gray-50 text-gray-500 text-sm border-r">utmpro.link/@@</span><input type="text" name="username" required pattern="[a-z0-9_]+" class="flex-1 px-3 py-2 focus:outline-none" placeholder="yourname"></div>
        </div>
        <div class="mb-4"><label class="block text-sm font-medium mb-2">Display Name</label><input type="text" name="displayName" class="w-full px-3 py-2 border rounded-lg"></div>
        <div class="mb-4"><label class="block text-sm font-medium mb-2">Bio</label><textarea name="bio" class="w-full px-3 py-2 border rounded-lg" rows="2" placeholder="Tell the world about yourself..."></textarea></div>
        <button type="submit" class="w-full bg-black text-white py-2.5 rounded-lg font-medium hover:bg-gray-800">Create Bio Page</button>
    </form>
    <p class="text-center text-xs text-gray-400 mt-4"><a href="/account/settings" class="hover:text-black">← Back to account</a></p>
</div>
</body></html>
