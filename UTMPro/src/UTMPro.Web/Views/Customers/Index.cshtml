@model List<Customer>
@{ ViewData["Title"] = "Customers"; }
<h1 class="text-2xl font-bold mb-6">Customers</h1>
<div class="bg-white rounded-xl border overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="text-center py-12"><p class="text-gray-500">No customers tracked yet</p></div>
    }
    else
    {
        <div class="table-wrap"><table class="w-full min-w-[600px]">
            <thead class="bg-gray-50 border-b"><tr>
                <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Customer</th>
                <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Country</th>
                <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">LTV</th>
                <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">First Seen</th>
            </tr></thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var c in Model)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3"><p class="text-sm font-medium">@(c.Name ?? "Anonymous")</p><p class="text-xs text-gray-500">@c.Email</p></td>
                        <td class="px-4 py-3 text-sm">@(c.Country ?? "Unknown")</td>
                        <td class="px-4 py-3 text-sm text-right font-medium">$@c.LTV.ToString("N2")</td>
                        <td class="px-4 py-3 text-sm text-gray-500">@c.CreatedAt.ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>
