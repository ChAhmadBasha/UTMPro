@model User
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Security - UTMPro</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-50 min-h-screen">
<div class="max-w-2xl mx-auto py-12 px-6">
    <h1 class="text-2xl font-bold mb-6">Account Settings</h1>
    <div class="flex gap-4 mb-6 border-b pb-3">
        <a href="/account/settings" class="text-sm text-gray-500 pb-3 -mb-3">Profile</a>
        <a href="/account/settings/security" class="text-sm font-medium text-black border-b-2 border-black pb-3 -mb-3">Security</a>
        <a href="/account/settings/referrals" class="text-sm text-gray-500 pb-3 -mb-3">Referrals</a>
    </div>
    @if (TempData["Success"] != null) { <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">@TempData["Success"]</div> }
    @if (ViewBag.Error != null) { <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">@ViewBag.Error</div> }
    <div class="bg-white rounded-xl border p-6">
        <h2 class="font-semibold text-lg mb-4">Change Password</h2>
        <form method="post" action="/account/settings/security">@Html.AntiForgeryToken()
            @if (Model.PasswordHash != null) { <div class="mb-4"><label class="block text-sm font-medium mb-2">Current Password</label><input type="password" name="currentPassword" required class="w-full px-3 py-2 border rounded-lg"></div> }
            <div class="mb-4"><label class="block text-sm font-medium mb-2">New Password</label><input type="password" name="newPassword" required minlength="8" class="w-full px-3 py-2 border rounded-lg"></div>
            <button type="submit" class="bg-black text-white px-6 py-2 rounded-lg font-medium hover:bg-gray-800">Update Password</button>
        </form>
    </div>
    @if (Model.GoogleId != null) { <div class="bg-white rounded-xl border p-6 mt-4"><p class="text-sm text-gray-600">✓ Connected with Google (@Model.GoogleId)</p></div> }
</div>
</body></html>
