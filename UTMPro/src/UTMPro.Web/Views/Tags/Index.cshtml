@model List<Tag>
@{ ViewData["Title"] = "Tags"; var ws = ViewBag.Workspace as Workspace; }
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Tags</h1>
    <button onclick="document.getElementById('createTagModal').classList.remove('hidden')" class="bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800">+ New Tag</button>
</div>
<div class="bg-white rounded-xl border overflow-hidden">
    @if (Model.Count == 0) { <div class="text-center py-12"><p class="text-gray-500">No tags yet</p></div> }
    else {
    <div class="table-wrap"><table class="w-full min-w-[600px]"><thead class="bg-gray-50 border-b"><tr>
        <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Tag</th>
        <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Links</th>
        <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Created</th>
        <th class="px-4 py-3"></th>
    </tr></thead><tbody class="divide-y divide-gray-100">
    @foreach (var t in Model) {
    <tr class="hover:bg-gray-50">
        <td class="px-4 py-3"><div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full" style="background-color:@t.Color"></div><span class="text-sm font-medium">@t.Name</span></div></td>
        <td class="px-4 py-3 text-sm text-right">@t.LinkCount</td>
        <td class="px-4 py-3 text-sm text-gray-500">@t.CreatedAt.ToString("MMM d, yyyy")</td>
        <td class="px-4 py-3"><form method="post" action="/@ws?.Slug/links/tags/@t.Id/delete" class="inline">@Html.AntiForgeryToken()<button type="submit" class="text-xs text-red-500 hover:underline" onclick="return confirm('Delete tag?')">Delete</button></form></td>
    </tr>}
    </tbody></table></div>}
</div>
<div id="createTagModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center">
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 sm:p-6 w-full max-w-md mx-2 sm:m-4">
        <div class="flex justify-between items-center mb-4"><h2 class="text-lg font-bold">Create Tag</h2><button onclick="document.getElementById('createTagModal').classList.add('hidden')" class="text-gray-400 text-2xl">&times;</button></div>
        <form method="post" action="/@ws?.Slug/links/tags">@Html.AntiForgeryToken()
            <div class="mb-4"><label class="block text-sm font-medium mb-2">Name</label><input type="text" name="name" required class="w-full px-3 py-2 border rounded-lg"></div>
            <div class="mb-4"><label class="block text-sm font-medium mb-2">Color</label><input type="color" name="color" value="#22c55e" class="w-12 h-8 border rounded"></div>
            <button type="submit" class="w-full bg-black text-white py-2 rounded-lg font-medium hover:bg-gray-800">Create Tag</button>
        </form>
    </div>
</div>
