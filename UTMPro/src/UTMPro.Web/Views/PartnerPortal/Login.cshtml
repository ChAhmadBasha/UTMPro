@model PartnerProgram
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Partner Login - @Model.ProgramName</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
<div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 w-full max-w-md mx-2">
    <h1 class="text-2xl font-bold text-center mb-2">Partner Login</h1>
    <p class="text-gray-500 text-center mb-6">@Model.ProgramName</p>
    @if(ViewBag.Error != null){<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">@ViewBag.Error</div>}
    <form method="post" action="/partners/@Model.Slug/login">
        <div class="mb-4"><label class="block text-sm font-medium mb-2">Email</label><input type="email" name="email" required class="w-full px-3 py-2 border rounded-lg" placeholder="your@email.com"></div>
        <button type="submit" class="w-full bg-black text-white py-2.5 rounded-lg font-medium hover:bg-gray-800">Sign In</button>
    </form>
    <div class="mt-4 text-center"><a href="/partners/@Model.Slug" class="text-sm text-gray-500 hover:text-black">New partner? Apply here</a></div>
</div>
</body></html>
