@model List<Folder>
@{ ViewData["Title"] = "Folders"; var ws = ViewBag.Workspace as Workspace; var max = (int)(ViewBag.MaxFolders ?? 5); }
<div class="flex items-center justify-between mb-6">
    <div><h1 class="text-2xl font-bold">Folders</h1><p class="text-gray-500 text-sm">@Model.Count of @max folders</p></div>
    <button onclick="document.getElementById('createFolderModal').classList.remove('hidden')" class="bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800">+ New Folder</button>
</div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
    @foreach (var f in Model)
    {
        <div class="bg-white rounded-xl border p-5 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-3 h-3 rounded-full" style="background-color: @f.Color"></div>
                <h3 class="font-semibold">@f.Name</h3>
            </div>
            <p class="text-sm text-gray-500">@f.LinkCount links</p>
            <div class="flex gap-2 mt-3">
                <a href="/@ws?.Slug/links?folderId=@f.Id" class="text-xs text-blue-600 hover:underline">View Links</a>
                @if (!f.IsDefault) {
                <form method="post" action="/@ws?.Slug/links/folders/@f.Id/delete" class="inline">@Html.AntiForgeryToken()
                    <button type="submit" class="text-xs text-red-500 hover:underline" onclick="return confirm('Delete this folder?')">Delete</button>
                </form>}
            </div>
        </div>
    }
</div>
<!-- Create Modal -->
<div id="createFolderModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center">
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-4 sm:p-6 w-full max-w-md mx-2 sm:m-4">
        <div class="flex justify-between items-center mb-4"><h2 class="text-lg font-bold">Create Folder</h2><button onclick="document.getElementById('createFolderModal').classList.add('hidden')" class="text-gray-400 text-2xl">&times;</button></div>
        <form method="post" action="/@ws?.Slug/links/folders">@Html.AntiForgeryToken()
            <div class="mb-4"><label class="block text-sm font-medium mb-2">Name</label><input type="text" name="name" required class="w-full px-3 py-2 border rounded-lg"></div>
            <div class="mb-4"><label class="block text-sm font-medium mb-2">Color</label><input type="color" name="color" value="#22c55e" class="w-12 h-8 border rounded"></div>
            <button type="submit" class="w-full bg-black text-white py-2 rounded-lg font-medium hover:bg-gray-800">Create Folder</button>
        </form>
    </div>
</div>
