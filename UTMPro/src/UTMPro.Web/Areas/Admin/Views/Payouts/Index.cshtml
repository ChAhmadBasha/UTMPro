@model List<PartnerPayout>
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Payouts Management"; }
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Payouts Management</h1>
    <div class="flex gap-2">
        @foreach(var s in new[]{("","All"),("Pending","Pending"),("Paid","Paid"),("Failed","Failed")}){
        <a href="/admin/payouts?status=@s.Item1" class="px-3 py-1.5 text-sm rounded-lg @(ViewBag.Status as string == s.Item1 ? "bg-black text-white" : "bg-white border hover:bg-gray-50")">@s.Item2</a>}
    </div>
</div>
<div class="bg-white rounded-xl border overflow-hidden">
@if(Model.Count==0){<div class="text-center py-12"><p class="text-gray-500">No payouts</p></div>}
else{<table class="w-full"><thead class="bg-gray-50 border-b"><tr>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Date</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Partner</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Amount</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Method</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Status</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Processed By</th>
    <th class="px-4 py-3"></th>
</tr></thead><tbody class="divide-y divide-gray-100">
@foreach(var p in Model){<tr class="hover:bg-gray-50">
    <td class="px-4 py-3 text-sm text-gray-500">@p.CreatedAt.ToString("MMM d, yyyy")</td>
    <td class="px-4 py-3"><span class="text-sm font-medium">@p.PartnerName</span><p class="text-xs text-gray-500">@p.PartnerEmail</p></td>
    <td class="px-4 py-3 text-sm text-right font-bold">$@p.Amount.ToString("N2")</td>
    <td class="px-4 py-3 text-sm">@p.PayoutMethod</td>
    <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs @(p.Status switch { "Paid" => "bg-green-100 text-green-700", "Failed" => "bg-red-100 text-red-700", _ => "bg-yellow-100 text-yellow-700" })">@p.Status</span></td>
    <td class="px-4 py-3 text-sm text-gray-500">@(p.ProcessedByName ?? "-")</td>
    <td class="px-4 py-3">@if(p.Status == "Pending"){
        <div class="flex gap-2">
            <form method="post" action="/admin/payouts/@p.Id/process">@Html.AntiForgeryToken()<button type="submit" class="px-3 py-1 bg-green-600 text-white rounded text-xs hover:bg-green-700" onclick="return confirm('Process payout of $@p.Amount.ToString("N2")?')">Process</button></form>
            <form method="post" action="/admin/payouts/@p.Id/reject">@Html.AntiForgeryToken()<input type="hidden" name="reason" value="Rejected"><button type="submit" class="px-3 py-1 bg-red-50 text-red-600 border border-red-200 rounded text-xs hover:bg-red-100">Reject</button></form>
        </div>}</td>
</tr>}</tbody></table>}
</div>
