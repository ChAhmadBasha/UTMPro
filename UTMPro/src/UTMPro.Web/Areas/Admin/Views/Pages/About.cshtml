@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Edit About Us"; }
<div class="flex items-center gap-3 mb-6">
    <a href="/admin/pages" class="text-gray-400 hover:text-gray-600">&larr;</a>
    <h1 class="text-2xl font-bold">Edit About Us Page</h1>
    <a href="/about" target="_blank" class="text-sm text-blue-600 hover:underline ml-auto">View live page →</a>
</div>
<form method="post" action="/admin/pages/about" class="max-w-3xl">
    @Html.AntiForgeryToken()
    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Basic Info</h2>
        <div class="mb-4">
            <label class="block text-sm font-medium mb-2">Page Title</label>
            <input type="text" name="title" value="@ViewBag.Title" class="w-full px-3 py-2.5 border rounded-lg focus:outline-none focus:ring-2 focus:ring-black">
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium mb-2">Content (HTML)</label>
            <textarea name="content" rows="10" class="w-full px-3 py-2.5 border rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-black" placeholder="<p>Your company story...</p>">@ViewBag.Content</textarea>
            <p class="text-xs text-gray-400 mt-1">Supports HTML. Use &lt;p&gt;, &lt;h2&gt;, &lt;ul&gt;, &lt;strong&gt;, etc.</p>
        </div>
    </div>

    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Mission & Vision</h2>
        <div class="mb-4">
            <label class="block text-sm font-medium mb-2">Mission Statement</label>
            <textarea name="mission" rows="2" class="w-full px-3 py-2.5 border rounded-lg text-sm" placeholder="Our mission is to...">@ViewBag.Mission</textarea>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium mb-2">Vision Statement</label>
            <textarea name="vision" rows="2" class="w-full px-3 py-2.5 border rounded-lg text-sm" placeholder="We envision a world where...">@ViewBag.Vision</textarea>
        </div>
    </div>

    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Team Members (JSON)</h2>
        <textarea name="teamJson" rows="6" class="w-full px-3 py-2.5 border rounded-lg font-mono text-sm" placeholder='[{"name":"John","role":"CEO","avatar":""}]'>@ViewBag.TeamJson</textarea>
        <p class="text-xs text-gray-400 mt-1">JSON array: <code>[{"name":"...", "role":"...", "avatar":"url or empty"}]</code></p>
    </div>

    <button type="submit" class="bg-black text-white px-8 py-2.5 rounded-lg font-medium hover:bg-gray-800">Save About Us Page</button>
</form>
