@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Site Branding"; }
<div class="flex items-center gap-3 mb-6">
    <a href="/admin/pages" class="text-gray-400 hover:text-gray-600">&larr;</a>
    <h1 class="text-2xl font-bold">Site Branding</h1>
    <a href="/" target="_blank" class="text-sm text-blue-600 hover:underline ml-auto">View site →</a>
</div>
<form method="post" action="/admin/pages/branding" class="max-w-3xl">
    @Html.AntiForgeryToken()

    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Logo & Favicon</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium mb-2">Site Logo</label>
                <div class="flex items-end gap-3">
                    @if (!string.IsNullOrEmpty(ViewBag.LogoUrl as string)) {
                    <img src="@ViewBag.LogoUrl" alt="Logo" class="h-12 rounded border">
                    }
                    <div class="flex-1">
                        <input type="text" name="logoUrl" value="@ViewBag.LogoUrl" class="w-full px-3 py-2 border rounded-lg text-sm" placeholder="/uploads/logos/logo.png">
                        <div class="mt-1">
                            <label class="text-xs text-blue-600 cursor-pointer hover:underline">
                                📤 Upload new logo
                                <input type="file" accept="image/*" class="hidden" onchange="uploadFile(this, '/admin/pages/branding/upload-logo', 'logoUrl')">
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Favicon</label>
                <div class="flex items-end gap-3">
                    @if (!string.IsNullOrEmpty(ViewBag.FaviconUrl as string)) {
                    <img src="@ViewBag.FaviconUrl" alt="Favicon" class="h-8 rounded border">
                    }
                    <div class="flex-1">
                        <input type="text" name="faviconUrl" id="faviconUrl" value="@ViewBag.FaviconUrl" class="w-full px-3 py-2 border rounded-lg text-sm" placeholder="/favicon.ico">
                        <div class="mt-1">
                            <label class="text-xs text-blue-600 cursor-pointer hover:underline">
                                📤 Upload favicon
                                <input type="file" accept=".ico,.png,.svg" class="hidden" onchange="uploadFile(this, '/admin/pages/branding/upload-favicon', 'faviconUrl')">
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Contact Information</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium mb-2">Contact Email</label>
                <input type="email" name="contactEmail" value="@ViewBag.ContactEmail" class="w-full px-3 py-2.5 border rounded-lg" placeholder="hello@company.com">
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Contact Phone</label>
                <input type="text" name="contactPhone" value="@ViewBag.ContactPhone" class="w-full px-3 py-2.5 border rounded-lg" placeholder="+1 (555) 123-4567">
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Footer</h2>
        <div>
            <label class="block text-sm font-medium mb-2">Footer Copyright Text</label>
            <input type="text" name="footerText" value="@ViewBag.FooterText" class="w-full px-3 py-2.5 border rounded-lg" placeholder="© 2026 Company. All rights reserved.">
        </div>
    </div>

    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Social Links</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium mb-2">Twitter / X</label>
                <input type="url" name="twitter" value="@ViewBag.Twitter" class="w-full px-3 py-2.5 border rounded-lg text-sm" placeholder="https://x.com/yourhandle">
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">LinkedIn</label>
                <input type="url" name="linkedin" value="@ViewBag.LinkedIn" class="w-full px-3 py-2.5 border rounded-lg text-sm" placeholder="https://linkedin.com/company/...">
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">GitHub</label>
                <input type="url" name="github" value="@ViewBag.Github" class="w-full px-3 py-2.5 border rounded-lg text-sm" placeholder="https://github.com/...">
            </div>
        </div>
    </div>

    <button type="submit" class="bg-black text-white px-8 py-2.5 rounded-lg font-medium hover:bg-gray-800">Save Branding</button>
</form>

<script>
async function uploadFile(input, url, fieldName) {
    if (!input.files[0]) return;
    const formData = new FormData();
    formData.append('file', input.files[0]);
    try {
        const res = await fetch(url, { method: 'POST', body: formData });
        if (res.ok) {
            const data = await res.json();
            const field = document.querySelector(`[name="${fieldName}"]`);
            if (field) field.value = data.url;
            location.reload();
        } else {
            alert('Upload failed. Max 2MB.');
        }
    } catch(e) { alert('Upload error'); }
}
</script>
