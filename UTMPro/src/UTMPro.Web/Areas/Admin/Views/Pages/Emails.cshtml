@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Email Templates"; }
<div class="flex items-center gap-3 mb-6">
    <a href="/admin/pages" class="text-gray-400 hover:text-gray-600">&larr;</a>
    <h1 class="text-2xl font-bold">Email Templates</h1>
</div>

<form method="post" action="/admin/pages/emails" class="max-w-3xl space-y-4">
    @Html.AntiForgeryToken()

    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm text-blue-800">
        <p class="font-semibold mb-1">📝 Template Variables</p>
        <p>Use these placeholders in your templates — they'll be replaced with real values when sent:</p>
        <div class="mt-2 grid grid-cols-2 gap-1 text-xs font-mono">
            <span><code>{name}</code> — User's name</span>
            <span><code>{email}</code> — User's email</span>
            <span><code>{code}</code> — 6-digit verification code</span>
            <span><code>{link}</code> — Action link URL</span>
            <span><code>{appUrl}</code> — App base URL</span>
            <span><code>{workspaceName}</code> — Workspace name</span>
            <span><code>{inviterName}</code> — Who sent invite</span>
        </div>
        <p class="mt-2 text-xs">Leave a template <strong>empty</strong> to use the built-in default template.</p>
    </div>

    <div class="bg-white rounded-xl border p-6">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">✉️ Verification Code Email</h2>
            <span class="text-xs text-gray-400">Sent on registration + unverified login</span>
        </div>
        <textarea name="verification" rows="10" class="w-full px-3 py-2.5 border rounded-lg font-mono text-sm" placeholder="Leave empty to use default template. Use {name}, {code}, {link}">@ViewBag.Verification</textarea>
    </div>

    <div class="bg-white rounded-xl border p-6">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">👋 Welcome Email</h2>
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="enableWelcome" value="true" @(ViewBag.EnableWelcome == "true" ? "checked" : "")>
                Enabled
            </label>
        </div>
        <textarea name="welcome" rows="10" class="w-full px-3 py-2.5 border rounded-lg font-mono text-sm" placeholder="Sent after email verification. Use {name}, {email}, {appUrl}">@ViewBag.Welcome</textarea>
    </div>

    <div class="bg-white rounded-xl border p-6">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">🔑 Password Reset Email</h2>
        </div>
        <textarea name="passwordReset" rows="8" class="w-full px-3 py-2.5 border rounded-lg font-mono text-sm" placeholder="Leave empty for default. Use {name}, {link}">@ViewBag.PasswordReset</textarea>
    </div>

    <div class="bg-white rounded-xl border p-6">
        <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold">📨 Workspace Invitation Email</h2>
        </div>
        <textarea name="invitation" rows="8" class="w-full px-3 py-2.5 border rounded-lg font-mono text-sm" placeholder="Leave empty for default. Use {name}, {workspaceName}, {inviterName}, {link}">@ViewBag.Invitation</textarea>
    </div>

    <button type="submit" class="bg-black text-white px-8 py-2.5 rounded-lg font-medium hover:bg-gray-800">Save Email Templates</button>
</form>
