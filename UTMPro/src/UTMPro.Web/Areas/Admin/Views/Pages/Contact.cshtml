@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Edit Contact Us"; }
<div class="flex items-center gap-3 mb-6">
    <a href="/admin/pages" class="text-gray-400 hover:text-gray-600">&larr;</a>
    <h1 class="text-2xl font-bold">Edit Contact Us Page</h1>
    <a href="/contact" target="_blank" class="text-sm text-blue-600 hover:underline ml-auto">View live page →</a>
</div>
<form method="post" action="/admin/pages/contact" class="max-w-3xl">
    @Html.AntiForgeryToken()
    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Page Content</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium mb-2">Page Title</label>
                <input type="text" name="title" value="@ViewBag.Title" class="w-full px-3 py-2.5 border rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Form Submissions Email</label>
                <input type="email" name="formEmail" value="@ViewBag.FormEmail" class="w-full px-3 py-2.5 border rounded-lg" placeholder="hello@company.com">
            </div>
        </div>
        <div class="mt-4">
            <label class="block text-sm font-medium mb-2">Subtitle / Description</label>
            <textarea name="subtitle" rows="2" class="w-full px-3 py-2.5 border rounded-lg text-sm">@ViewBag.Subtitle</textarea>
        </div>
    </div>

    <div class="bg-white rounded-xl border p-6 mb-4">
        <h2 class="font-semibold mb-4">Contact Details</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium mb-2">Phone Number</label>
                <input type="text" name="phone" value="@ViewBag.Phone" class="w-full px-3 py-2.5 border rounded-lg" placeholder="+1 (555) 123-4567">
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Address</label>
                <input type="text" name="address" value="@ViewBag.Address" class="w-full px-3 py-2.5 border rounded-lg" placeholder="123 Main St, City, Country">
            </div>
        </div>
        <div class="mt-4">
            <label class="block text-sm font-medium mb-2">Google Maps Embed URL (optional)</label>
            <input type="url" name="mapEmbed" value="@ViewBag.MapEmbed" class="w-full px-3 py-2.5 border rounded-lg text-sm" placeholder="https://www.google.com/maps/embed?pb=...">
            <p class="text-xs text-gray-400 mt-1">Get this from Google Maps → Share → Embed → copy the src URL</p>
        </div>
    </div>

    <button type="submit" class="bg-black text-white px-8 py-2.5 rounded-lg font-medium hover:bg-gray-800">Save Contact Us Page</button>
</form>
