@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Edit Privacy Policy"; }
<div class="flex items-center gap-3 mb-6">
    <a href="/admin/pages" class="text-gray-400 hover:text-gray-600">&larr;</a>
    <h1 class="text-2xl font-bold">Edit Privacy Policy</h1>
    <a href="/privacy" target="_blank" class="text-sm text-blue-600 hover:underline ml-auto">View live page →</a>
</div>
<form method="post" action="/admin/pages/privacy" class="max-w-3xl">
    @Html.AntiForgeryToken()
    <div class="bg-white rounded-xl border p-6 mb-4">
        <label class="block text-sm font-medium mb-2">Privacy Policy Content (HTML)</label>
        <textarea name="content" rows="25" class="w-full px-3 py-2.5 border rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-black" placeholder="<h2>Privacy Policy</h2><p>...</p>">@ViewBag.Content</textarea>
        <p class="text-xs text-gray-400 mt-1">Full HTML supported. This content is displayed at /privacy</p>
    </div>
    <button type="submit" class="bg-black text-white px-8 py-2.5 rounded-lg font-medium hover:bg-gray-800">Save Privacy Policy</button>
</form>
