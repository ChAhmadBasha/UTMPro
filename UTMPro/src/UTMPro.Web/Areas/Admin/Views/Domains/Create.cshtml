@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Add Domain"; }
<div class="flex items-center gap-3 mb-6"><a href="/admin/domains" class="text-gray-400">&larr;</a><h1 class="text-2xl font-bold">Add Domain</h1></div>
<div class="bg-white rounded-xl border p-6 max-w-2xl">
<form method="post" action="/admin/domains/create">@Html.AntiForgeryToken()
    <div class="mb-4"><label class="block text-sm font-medium mb-2">Domain Name</label><input type="text" name="domain" required class="w-full px-3 py-2 border rounded-lg" placeholder="links.example.com"></div>
    <div class="mb-4 flex gap-6">
        <label class="flex items-center gap-2"><input type="checkbox" name="isSystemDomain" value="true"><span class="text-sm">System Domain (shared by all users)</span></label>
        <label class="flex items-center gap-2"><input type="checkbox" name="isPrimary" value="true"><span class="text-sm">Primary Domain</span></label>
    </div>
    <div class="mb-4"><label class="block text-sm font-medium mb-2">Description</label><input type="text" name="description" class="w-full px-3 py-2 border rounded-lg" placeholder="Optional description"></div>
    <div class="mb-4">
        <label class="block text-sm font-medium mb-2">Visibility</label>
        <select name="visibility" class="w-full px-3 py-2 border rounded-lg">
            <option value="General">General (all users)</option>
            <option value="PlanBased">Plan-Based (specific plans only)</option>
            <option value="UserSpecific">User-Specific</option>
            <option value="WorkspaceOnly">Workspace-Only</option>
        </select>
    </div>
    <div class="mb-4"><label class="block text-sm font-medium mb-2">Allowed Plan IDs (comma-separated)</label><input type="text" name="allowedPlanIds" class="w-full px-3 py-2 border rounded-lg" placeholder="2,3,4 (leave empty for General)"></div>
    <div class="bg-gray-50 p-4 rounded-lg mb-4 text-sm">
        <p class="font-medium">DNS Instructions:</p>
        <p>Create a CNAME record pointing to <code class="bg-gray-200 px-1 rounded">@ViewBag.CustomDomainTarget</code></p>
    </div>
    <button type="submit" class="w-full bg-black text-white py-2 rounded-lg font-medium hover:bg-gray-800">Add Domain</button>
</form>
</div>
