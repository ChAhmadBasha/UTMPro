@model List<AdminTrafficRule>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Traffic Rules";
}
<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Admin Traffic Rules</h1>
    <div class="flex items-center gap-2">
        <a href="/admin/traffic-rules/report" class="bg-orange-100 text-orange-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-orange-200">Daily Report</a>
        <a href="/admin/traffic-rules/create" class="bg-black text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800">+ New Rule</a>
    </div>
</div>
<div class="mb-4 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
    Workspace rules override global rules. If multiple active rules exist at the same scope, the most recently updated rule is used.
</div>
<div class="bg-white rounded-xl border overflow-hidden">
@if (Model.Count == 0)
{
    <div class="text-center py-12"><p class="text-gray-500">No traffic rules</p></div>
}
else
{
<table class="w-full">
<thead class="bg-gray-50 border-b"><tr>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Rule Name</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Scope</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Traffic %</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">URLs</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Status</th>
    <th class="px-4 py-3"></th>
</tr></thead>
<tbody class="divide-y divide-gray-100">
@foreach (var rule in Model)
{
<tr class="hover:bg-gray-50">
    <td class="px-4 py-3 text-sm font-medium"><a href="/admin/traffic-rules/@rule.Id" class="text-blue-600 hover:underline">@rule.RuleName</a></td>
    <td class="px-4 py-3">
        <span class="px-2 py-1 rounded text-xs @(rule.IsGlobal ? "bg-blue-100 text-blue-700" : "bg-gray-100 text-gray-700")">
            @(rule.IsGlobal ? "Global" : $"Workspace #{rule.WorkspaceId}")
        </span>
    </td>
    <td class="px-4 py-3 text-sm text-right font-medium">@rule.TrafficPercent%</td>
    <td class="px-4 py-3 text-sm text-right">@rule.Urls.Count</td>
    <td class="px-4 py-3">
        <span class="px-2 py-1 rounded text-xs @(rule.IsActive ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">@(rule.IsActive ? "Active" : "Disabled")</span>
    </td>
    <td class="px-4 py-3 text-right">
        <div class="inline-flex items-center gap-3">
            @if (rule.Urls.Any(url => url.IsActive))
            {
                <a href="/admin/traffic-rules/@rule.Id/test" target="_blank" rel="noopener" class="text-sm text-orange-600 hover:underline" title="Always open a configured admin URL; does not count in analytics">Test</a>
            }
            <a href="/admin/traffic-rules/@rule.Id" class="text-sm text-gray-500 hover:text-black">Edit</a>
            <form method="post" action="/admin/traffic-rules/@rule.Id/toggle" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="text-sm @(rule.IsActive ? "text-red-600" : "text-green-600")">@(rule.IsActive ? "Disable" : "Enable")</button>
            </form>
        </div>
    </td>
</tr>
}
</tbody>
</table>
}
</div>
