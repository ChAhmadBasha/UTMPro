@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Traffic Rule";
    var workspaces = ViewBag.Workspaces as List<Workspace> ?? new List<Workspace>();
}
<div class="flex items-center gap-3 mb-6">
    <a href="/admin/traffic-rules" class="text-gray-400">&larr;</a>
    <h1 class="text-2xl font-bold">Create Traffic Rule</h1>
</div>
<div class="bg-white rounded-xl border p-6 max-w-2xl">
<form method="post" action="/admin/traffic-rules/create">
    @Html.AntiForgeryToken()
    <div class="mb-4">
        <label class="block text-sm font-medium mb-2">Rule Name</label>
        <input type="text" name="ruleName" maxlength="100" required class="w-full px-3 py-2 border rounded-lg">
    </div>
    <div class="mb-4">
        <label class="block text-sm font-medium mb-2">Traffic Percentage</label>
        <input type="number" name="trafficPercent" step="0.01" min="0.01" max="100" value="10" required class="w-full px-3 py-2 border rounded-lg">
        <p class="text-xs text-gray-500 mt-1">Applied to overall eligible traffic before targeting and normal destination selection. A new link is excluded until it reaches the warm-up click count configured on the Traffic Rules page (default 500).</p>
    </div>
    <div class="mb-4">
        <label class="flex items-center gap-2">
            <input id="isGlobal" type="checkbox" name="isGlobal" value="true" onchange="toggleWorkspace()">
            <span class="text-sm font-medium">Global rule (applies to all workspaces without a workspace rule)</span>
        </label>
    </div>
    <div id="workspaceField" class="mb-4">
        <label class="block text-sm font-medium mb-2">Workspace</label>
        <select id="workspaceId" name="workspaceId" class="w-full px-3 py-2 border rounded-lg">
            <option value="">Select a workspace</option>
            @foreach (var workspace in workspaces)
            {
                <option value="@workspace.Id">@workspace.Name (@workspace.Slug)</option>
            }
        </select>
        <p class="text-xs text-gray-500 mt-1">Required when the rule is not global.</p>
    </div>
    <div class="mb-4">
        <label class="block text-sm font-medium mb-2">Admin URLs</label>
        <div id="urlRows" class="space-y-2">
            <div class="flex gap-2">
                <input type="url" name="urls" required placeholder="https://sponsor.com/link" class="flex-1 px-3 py-2 border rounded-lg text-sm">
                <input type="number" name="weights" value="100" min="1" max="10000" class="w-20 px-2 py-2 border rounded-lg text-sm" placeholder="Weight">
                <input type="text" name="labels" maxlength="100" placeholder="Label" class="w-32 px-2 py-2 border rounded-lg text-sm">
            </div>
        </div>
        <button type="button" onclick="addUrlRow()" class="mt-2 text-sm text-blue-600 hover:underline">+ Add URL</button>
    </div>
    <button type="submit" class="bg-black text-white px-6 py-2 rounded-lg font-medium hover:bg-gray-800">Create Rule</button>
</form>
</div>
<script>
function toggleWorkspace() {
    const isGlobal = document.getElementById('isGlobal').checked;
    const select = document.getElementById('workspaceId');
    document.getElementById('workspaceField').classList.toggle('hidden', isGlobal);
    select.required = !isGlobal;
    select.disabled = isGlobal;
}
function addUrlRow() {
    const row = document.createElement('div');
    row.className = 'flex gap-2';
    row.innerHTML = '<input type="url" name="urls" required placeholder="https://..." class="flex-1 px-3 py-2 border rounded-lg text-sm"><input type="number" name="weights" value="100" min="1" max="10000" class="w-20 px-2 py-2 border rounded-lg text-sm"><input type="text" name="labels" maxlength="100" placeholder="Label" class="w-32 px-2 py-2 border rounded-lg text-sm"><button type="button" onclick="this.parentElement.remove()" class="text-red-500 text-sm">&#10005;</button>';
    document.getElementById('urlRows').appendChild(row);
}
toggleWorkspace();
</script>
