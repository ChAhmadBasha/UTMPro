@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Create Traffic Rule"; }
<div class="flex items-center gap-3 mb-6"><a href="/admin/traffic-rules" class="text-gray-400">&larr;</a><h1 class="text-2xl font-bold">Create Traffic Rule</h1></div>
<div class="bg-white rounded-xl border p-6 max-w-2xl">
<form method="post" action="/admin/traffic-rules/create">@Html.AntiForgeryToken()
    <div class="mb-4"><label class="block text-sm font-medium mb-2">Rule Name</label><input type="text" name="ruleName" required class="w-full px-3 py-2 border rounded-lg"></div>
    <div class="mb-4"><label class="block text-sm font-medium mb-2">Traffic Percentage</label><input type="number" name="trafficPercent" step="0.01" min="0.01" max="100" value="10" class="w-full px-3 py-2 border rounded-lg"></div>
    <div class="mb-4"><label class="flex items-center gap-2"><input type="checkbox" name="isGlobal" value="true"><span class="text-sm font-medium">Global Rule (applies to all workspaces)</span></label></div>
    <div class="mb-4">
        <label class="block text-sm font-medium mb-2">Admin URLs</label>
        <div id="urlRows" class="space-y-2">
            <div class="flex gap-2"><input type="url" name="urls" required placeholder="https://sponsor.com/link" class="flex-1 px-3 py-2 border rounded-lg text-sm"><input type="number" name="weights" value="100" min="1" max="10000" class="w-20 px-2 py-2 border rounded-lg text-sm" placeholder="Weight"><input type="text" name="labels" placeholder="Label" class="w-32 px-2 py-2 border rounded-lg text-sm"></div>
        </div>
        <button type="button" onclick="addUrlRow()" class="mt-2 text-sm text-blue-600 hover:underline">+ Add URL</button>
    </div>
    <button type="submit" class="bg-black text-white px-6 py-2 rounded-lg font-medium hover:bg-gray-800">Create Rule</button>
</form>
</div>
<script>
function addUrlRow() {
    const row = document.createElement('div');
    row.className = 'flex gap-2';
    row.innerHTML = '<input type="url" name="urls" required placeholder="https://..." class="flex-1 px-3 py-2 border rounded-lg text-sm"><input type="number" name="weights" value="100" min="1" class="w-20 px-2 py-2 border rounded-lg text-sm"><input type="text" name="labels" placeholder="Label" class="w-32 px-2 py-2 border rounded-lg text-sm"><button type="button" onclick="this.parentElement.remove()" class="text-red-500 text-sm">✕</button>';
    document.getElementById('urlRows').appendChild(row);
}
</script>
