@model List<PartnerProgram>
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Partner Programs"; }
<h1 class="text-2xl font-bold mb-6">Partner Programs</h1>
<div class="bg-white rounded-xl border overflow-hidden">
@if(Model.Count==0){<div class="text-center py-12"><p class="text-gray-500">No partner programs created yet</p></div>}
else{<table class="w-full"><thead class="bg-gray-50 border-b"><tr>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Program</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Workspace</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Commission</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Partners</th>
    <th class="text-right px-4 py-3 text-xs font-medium text-gray-500 uppercase">Revenue</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Status</th>
</tr></thead><tbody class="divide-y divide-gray-100">
@foreach(var p in Model){<tr class="hover:bg-gray-50">
    <td class="px-4 py-3"><a href="/admin/partner-programs/@p.Id" class="text-sm font-medium text-blue-600 hover:underline">@p.ProgramName</a><p class="text-xs text-gray-500">/@p.Slug</p></td>
    <td class="px-4 py-3 text-sm">@p.WorkspaceName</td>
    <td class="px-4 py-3 text-sm">@p.CommissionValue@(p.CommissionType == "Percentage" ? "%" : " flat") · @p.CommissionDuration</td>
    <td class="px-4 py-3 text-sm text-right">@p.TotalPartners</td>
    <td class="px-4 py-3 text-sm text-right font-medium">$@p.TotalRevenue.ToString("N2")</td>
    <td class="px-4 py-3"><span class="px-2 py-1 rounded text-xs @(p.IsActive ? "bg-green-100 text-green-700" : "bg-gray-100 text-gray-500")">@(p.IsActive ? "Active" : "Inactive")</span></td>
</tr>}</tbody></table>}
</div>
