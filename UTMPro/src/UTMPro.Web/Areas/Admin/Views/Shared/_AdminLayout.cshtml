<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>@(ViewData["Title"] ?? "Admin") - UTMPro Admin</title><script src="https://cdn.tailwindcss.com"></script>
<style>.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}</style>
</head>
<body class="bg-gray-50 min-h-screen">

<!-- Mobile overlay -->
<div id="adminOverlay" class="hidden fixed inset-0 bg-black/50 z-40 lg:hidden" onclick="document.getElementById('adminSidebar').classList.add('-translate-x-full');this.classList.add('hidden')"></div>

<!-- Admin Sidebar -->
<aside id="adminSidebar" class="fixed left-0 top-0 h-screen w-[220px] bg-gray-900 text-white flex flex-col z-50 transform -translate-x-full lg:translate-x-0 transition-transform duration-200">
    <div class="p-4 border-b border-gray-700 flex items-center justify-between">
        <span class="font-bold text-lg">UTMPro Admin</span>
        <button onclick="document.getElementById('adminSidebar').classList.add('-translate-x-full');document.getElementById('adminOverlay').classList.add('hidden')" class="lg:hidden text-gray-400">✕</button>
    </div>
    <nav class="flex-1 p-3 space-y-1 text-sm overflow-y-auto">
        <a href="/admin" class="block px-3 py-2 rounded-lg hover:bg-gray-800">📊 Dashboard</a>
        <a href="/admin/analytics" class="block px-3 py-2 rounded-lg hover:bg-gray-800">📈 Analytics</a>
        <a href="/admin/users" class="block px-3 py-2 rounded-lg hover:bg-gray-800">👥 Users</a>
        <a href="/admin/workspaces" class="block px-3 py-2 rounded-lg hover:bg-gray-800">🏢 Workspaces</a>
        <a href="/admin/plans" class="block px-3 py-2 rounded-lg hover:bg-gray-800">💎 Plans & Offers</a>
        <a href="/admin/traffic-rules" class="block px-3 py-2 rounded-lg hover:bg-gray-800">🔀 Traffic Rules</a>
        <a href="/admin/domains" class="block px-3 py-2 rounded-lg hover:bg-gray-800">🌐 Domains</a>
        <p class="text-xs text-gray-500 px-3 mt-3 mb-1">PHASE 2</p>
        <a href="/admin/partner-programs" class="block px-3 py-2 rounded-lg hover:bg-gray-800">🤝 Partners</a>
        <a href="/admin/payouts" class="block px-3 py-2 rounded-lg hover:bg-gray-800">💸 Payouts</a>
        <a href="/admin/fraud" class="block px-3 py-2 rounded-lg hover:bg-gray-800">🛡️ Fraud</a>
        <a href="/admin/stripe-events" class="block px-3 py-2 rounded-lg hover:bg-gray-800">💳 Stripe</a>
        <a href="/admin/blog" class="block px-3 py-2 rounded-lg hover:bg-gray-800">📝 Blog</a>
        <a href="/admin/pages" class="block px-3 py-2 rounded-lg hover:bg-gray-800">📄 Pages</a>
        <a href="/admin/settings" class="block px-3 py-2 rounded-lg hover:bg-gray-800">⚙️ Settings</a>
    </nav>
    <div class="p-3 border-t border-gray-700"><a href="/" class="block px-3 py-2 text-sm text-gray-400 hover:text-white">← Back to App</a></div>
</aside>

<!-- Main Content -->
<main class="lg:ml-[220px] min-h-screen">
    <!-- Mobile header -->
    <div class="lg:hidden flex items-center gap-3 p-4 bg-white border-b sticky top-0 z-30">
        <button onclick="document.getElementById('adminSidebar').classList.remove('-translate-x-full');document.getElementById('adminOverlay').classList.remove('hidden')" class="p-2 -ml-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <span class="font-bold">UTMPro Admin</span>
    </div>
    <div class="p-4 sm:p-6">
        @if(TempData["Success"]!=null){<div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">@TempData["Success"]</div>}
        @if(TempData["Error"]!=null){<div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">@TempData["Error"]</div>}
        @RenderBody()
    </div>
</main>
</body></html>
