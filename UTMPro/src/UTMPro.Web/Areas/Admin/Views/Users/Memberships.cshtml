@model User
@{ Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; ViewData["Title"] = "Memberships - " + Model.Name; var memberships = ViewBag.Memberships as List<dynamic>; }
<div class="flex items-center gap-3 mb-6"><a href="/admin/users/@Model.Id" class="text-gray-400">&larr;</a><h1 class="text-2xl font-bold">Memberships: @Model.Name</h1></div>

<!-- Add to workspace -->
<div class="bg-white rounded-xl border p-6 mb-6 max-w-2xl">
    <h2 class="font-semibold mb-3">Add to Workspace</h2>
    <form method="post" action="/admin/users/@Model.Id/memberships/add" class="flex gap-3">@Html.AntiForgeryToken()
        <input type="number" name="workspaceId" required placeholder="Workspace ID" class="px-3 py-2 border rounded-lg text-sm w-40">
        <select name="role" class="px-3 py-2 border rounded-lg text-sm"><option>Member</option><option>Admin</option><option>Viewer</option><option>Owner</option></select>
        <button type="submit" class="px-4 py-2 bg-black text-white rounded-lg text-sm font-medium hover:bg-gray-800">Add</button>
    </form>
</div>

<div class="bg-white rounded-xl border overflow-hidden">
@if (memberships == null || memberships.Count == 0) { <div class="text-center py-12"><p class="text-gray-500">User is not a member of any workspace</p></div> }
else {
<table class="w-full"><thead class="bg-gray-50 border-b"><tr>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Workspace</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Plan</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Role</th>
    <th class="text-left px-4 py-3 text-xs font-medium text-gray-500 uppercase">Joined</th>
    <th class="px-4 py-3 text-xs font-medium text-gray-500 uppercase">Actions</th>
</tr></thead><tbody class="divide-y divide-gray-100">
@foreach (var m in memberships) {
<tr class="hover:bg-gray-50">
    <td class="px-4 py-3"><span class="text-sm font-medium">@m.WorkspaceName</span><p class="text-xs text-gray-500">@m.WorkspaceSlug</p></td>
    <td class="px-4 py-3"><span class="px-2 py-1 bg-gray-100 rounded text-xs">@m.PlanName</span></td>
    <td class="px-4 py-3">
        <form method="post" action="/admin/users/@Model.Id/memberships/@m.WorkspaceId/role" class="flex gap-2">@Html.AntiForgeryToken()
            <select name="role" class="px-2 py-1 border rounded text-sm">
                @foreach (var r in new[] { "Owner", "Admin", "Member", "Viewer" }) { <option value="@r" selected="@((string)m.Role == r)">@r</option> }
            </select>
            <button type="submit" class="px-3 py-1 bg-blue-600 text-white rounded text-xs hover:bg-blue-700">Update</button>
        </form>
    </td>
    <td class="px-4 py-3 text-sm text-gray-500">@(m.JoinedAt != null ? ((DateTime)m.JoinedAt).ToString("MMM d, yyyy") : "Pending")</td>
    <td class="px-4 py-3">
        <form method="post" action="/admin/users/@Model.Id/memberships/@m.WorkspaceId/remove" class="inline">@Html.AntiForgeryToken()
            <button type="submit" class="text-xs text-red-500 hover:underline" onclick="return confirm('Remove from workspace?')">Remove</button>
        </form>
    </td>
</tr>}
</tbody></table>}
</div>
